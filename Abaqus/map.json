{
  "$include": [
    "drona_cancel_jobs",
    "drona_cpu_monitor",
    "drona_gpu_monitor_nvml"
  ],
  "JOBNAME": "$name",
  "DRIVER": "!retrieve_driver_contents($drona_create_manage_mode, $drona_cancel_jobs)",
  "MANAGE": "!retrieve_workflow_actions($drona_create_manage_mode, $drona_delete_workflow, $drona_delete_files, $drona_create_manage_allworkflows, $drona_job_dir)",
  "DUMMY": "!retrieve_abaqus_slurm_params($parallel, $cores, $nodes, $inputfile, $drona_memory, $drona_gpu, $drona_numgpu, $drona_walltime, $drona_account, $drona_extra_slurm)",
  "LOADABAQUS": "!retrieve_abaqus_module($version)",
  "INPUT": "!retrieve_input($inputfile)",
  "ABQ_OPTIONS": "!retrieve_options($abqoptions)",
  "ABQ_EXTRA": "!retrieve_abaqus_extras($version, $inputfile, $usersub, $precision, $runtype, $oldjob, $globalmodel)"
}
