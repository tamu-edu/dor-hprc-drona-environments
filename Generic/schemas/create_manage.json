{
  "drona_configure": {
    "type": "hidden",
    "label": "configured",
    "name": "drona_create_manage_configured",
    "isDynamic": true,
    "retriever": "drona_info_configure.sh"
  },
  "drona_ManageCreateContainer": {
    "type": "rowContainer",
    "condition": "drona_create_manage_configured.CONFIGURED",
    "layout": {
      "preset": "card",
      "title": "Select Workflow Mode",
      "dot": false,
      "accent": true
    },
    "elements": {
      "drona_mode": {
        "type": "radioGroup",
        "style": "button",
        "label": "Mode",
        "useLabel": false,
        "name": "drona_create_manage_mode",
        "condition": "drona_create_manage_configured.CONFIGURED",
        "options": [
          {
            "label": "Create",
            "value": "create"
          },
          {
            "label": "Manage",
            "value": "manage"
          }
        ]
      },
      "drona_envSelect": {
        "type": "dynamicTable",
        "label": "Select Workflow",
        "labelOnTop": true,
        "name": "drona_create_manage_allworkflows",
        "condition": "drona_create_manage_mode.manage",
        "retriever": "builtin:db_options",
        "maxHeight": "250px",
        "retrieverParams": {
          "columns": {
            "Name": "{name}",
            "ID": "{drona_id}",
            "Date": "{start_time:10}",
            "Location": "{location}"
          }
        },
        "pagination": true,
        "columns": [
          {
            "width": "28%"
          },
          {
            "width": "90px"
          },
          {
            "width": "120px"
          },
          {}
        ],
        "collapseOnSelect": true
      }
    }
  }
}
