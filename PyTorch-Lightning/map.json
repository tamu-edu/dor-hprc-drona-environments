  "setupEnv": "!setup_pytorch_modules_if_run($drona_create_manage_mode, $modelCategory, $datasetType, $builtinDataset, $seqBuiltinDataset, $graphBuiltinDataset, $genBuiltinDataset, $nlpDatasetType, $nlpBuiltinDataset, $tabDatasetType, $tabBuiltinDataset, $audioDatasetType, $audioBuiltinDataset, $drona_gpu, $graphDatasetType, $exportOnnx)",
