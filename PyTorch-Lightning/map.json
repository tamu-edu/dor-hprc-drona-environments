{
  "$include": [
    "drona_cancel_jobs",
    "drona_cpu_monitor",
    "drona_gpu_monitor"
  ],
  "JOBNAME": "!sanitize_job_name($name)",
  "DRIVER": "!retrieve_driver_contents($drona_create_manage_mode, $drona_cancel_jobs)",
  "DUMMY": "!retrieve_pt_slurm_params($drona_create_manage_mode, $modelCategory, $drona_nodes, $numWorkers, $drona_memory, $drona_gpu, $drona_numgpu, $drona_walltime, $drona_account, $drona_extra_slurm)",
  "flocation": "$location",
