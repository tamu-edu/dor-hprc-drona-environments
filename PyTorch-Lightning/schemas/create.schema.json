              }
            ],
            "help": "Select NLP modeling architecture for text classification or seq2seq tasks accepting .csv, .tsv, or .txt datasets."
          },
          "nlpMaxSeqLen": {
            "type": "number",
            "label": "Max sequence length",
            "name": "nlpMaxSeqLen",
            "value": "128",
            "help": "Max token sequence length for truncation/padding.",
            "min": 8,
            "max": 8192
          }
        }
      },
      "tabModelRow": {
        "type": "rowContainer",
        "label": "Architecture",
        "condition": "modelCategory.tabular",
        "elements": {
          "tabModelType": {
            "type": "select",
            "label": "",
            "name": "tabModelType",
            "value": "mlp",
            "options": [
              {
                "value": "mlp",
                "label": "DeepMLP"
              },
              {
                "value": "resnet",
                "label": "ResNet for Tabular"
              },
              {
                "value": "tabnet",
                "label": "TabNet Primitives"
              }
            ],
            "help": "Select Tabular deep learning architecture (DeepMLP, ResNet, TabNet) to train on structured .csv data."
          },
          "tabTaskType": {
            "type": "radioGroup",
            "name": "tabTaskType",
            "label": "Task type",
            "options": [
              {
                "label": "Regression",
                "value": "regression"
              },
              {
                "label": "Classification",
                "value": "classification"
              }
            ],
            "value": "regression",
            "help": "Choose between regression (continuous values) or classification (discrete classes) for your tabular task."
          }
        }
      },
      "audioModelRow": {
        "type": "rowContainer",
        "label": "Architecture",
        "condition": "modelCategory.audio",
        "elements": {
          "audioModelType": {
            "type": "select",
            "label": "",
            "name": "audioModelType",
            "value": "classification",
            "options": [
              {
                "value": "classification",
                "label": "Acoustic Classification"
              },
              {
                "value": "speech",
                "label": "Speech Processing"
              },
              {
                "value": "synthesis",
                "label": "Waveform Synthesis"
              }
            ],
            "help": "Select audio modeling task and architecture (accepts .wav, .mp3, .flac, .ogg audio files)."
          },
          "audioTransformType": {
            "type": "select",
            "label": "Audio features",
            "name": "audioTransformType",
            "value": "mel_spectrogram",
            "options": [
              {
                "value": "mel_spectrogram",
                "label": "Mel-Spectrogram"
              },
              {
                "value": "spectrogram",
                "label": "Spectrogram"
              },
              {
                "value": "mfcc",
                "label": "MFCC"
              }
            ],
            "help": "How raw audio is turned into model input (torchaudio.transforms)."
          }
        }
      },
      "genModelRow": {
        "type": "rowContainer",
        "label": "Architecture",
        "condition": "modelCategory.generative",
        "elements": {
          "genModelType": {
            "type": "select",
            "label": "",
            "name": "genModelType",
            "value": "vae",
            "options": [
              {
                "value": "vae",
                "label": "VAE (Variational Autoencoder)"
              },
              {
                "value": "gan",
                "label": "GAN (Generative Adversarial Network)"
              },
              {
                "value": "diffusion",
                "label": "Diffusion Model (DDPM)"
              }
            ],
            "help": "Select generative model architecture (VAE, GAN, or Diffusion DDPM) for image generation from raw images (.png, .jpg, .jpeg, .bmp, .webp) or .pt tensors."
          },
          "latentDim": {
            "type": "number",
            "label": "Latent dimension (z)",
            "name": "latentDim",
            "value": "128",
            "min": 1
          }
        }
      },
      "gnnModelRow": {
        "type": "rowContainer",
        "label": "Architecture",
        "condition": "modelCategory.gnn",
        "elements": {
          "gnnLayerType": {
            "type": "select",
            "label": "",
            "name": "gnnLayerType",
            "value": "gcn",
            "options": [
              {
                "value": "gcn",
                "label": "GCN (Graph Convolutional Network)"
              },
              {
                "value": "gat",
                "label": "GAT (Graph Attention Network)"
              },
              {
                "value": "sage",
                "label": "GraphSAGE"
              }
            ],
            "help": "Select GNN message-passing architecture (GCN, GAT, GraphSAGE) to train on graph .pt datasets."
          },
          "gnnHiddenDim": {
            "type": "number",
            "label": "Hidden dimension",
            "name": "gnnHiddenDim",
            "value": "64",
            "min": 1
          },
          "gnnNumLayers": {
            "type": "number",
            "label": "Number of layers",
            "name": "gnnNumLayers",
            "value": "2",
            "min": 1,
            "max": 32
          }
        }
      }
    }
  },
  "trainingCard": {
    "type": "container",
    "layout": {
      "preset": "card",
      "title": "TRAINING",
      "dot": false
    },
    "elements": {
      "trainRow": {
        "type": "rowContainer",
        "label": "",
        "elements": {
          "epochs": {
            "type": "number",
            "label": "Epochs",
            "name": "epochs",
            "value": "10",
            "min": 1
          },
          "batchSize": {
            "type": "number",
            "label": "Batch size",
            "name": "batchSize",
            "value": "32",
            "min": 1,
            "help": "Samples per step for each training process. With several GPUs the effective batch is this times the number of GPUs."
          },
          "learningRate": {
            "type": "text",
            "label": "Learning rate",
            "name": "learningRate",
            "value": "1e-3",
            "placeholder": "e.g. 0.001 or 1e-3",
            "help": "Decimal or scientific notation only (e.g. 0.001, 1e-3). Invalid values are rejected when the job script is generated."
          }
        }
      },
      "trainingAdvanced": {
        "type": "collapsibleRowContainer",
        "title": "ADVANCED",
        "default_state": "collapsed",
        "layout": {
          "preset": "card",
          "title": "ADVANCED",
          "summary": "seed $seed · precision $precision · log every $logEveryNSteps steps · checkpoint $checkpointEnable · ONNX $exportOnnx",
          "compact": true
        },
        "elements": {
          "advRow1": {
            "type": "rowContainer",
            "label": "",
            "elements": {
              "seed": {
                "type": "number",
                "label": "Random seed",
                "name": "seed",
                "value": "42",
                "help": "Seed for PyTorch Lightning and dataset randomness. Default is 42.",
                "min": 0
              },
              "precision": {
                "type": "select",
                "name": "precision",
                "label": "Training precision",
                "value": "tf32",
                "options": [
                  {
                    "value": "tf32",
                    "label": "TF32 (recommended for H100/A30 Tensor Cores)"
                  },
                  {
                    "value": "bf16-mixed",
                    "label": "BF16 mixed precision (precision='bf16-mixed')"
                  },
                  {
                    "value": "16-mixed",
                    "label": "FP16 mixed precision (precision='16-mixed')"
                  },
                  {
                    "value": "32",
                    "label": "FP32 full precision (no TF32)"
                  }
                ],
                "help": "Controls numeric precision and Tensor Core use. TF32 keeps float32 Trainer precision but calls torch.set_float32_matmul_precision('high') for faster matmuls on H100/A30. BF16 mixed enables Lightning automatic mixed precision (precision='bf16-mixed') for additional speedup. FP32 disables Tensor Core TF32 (highest precision, slower)."
              },
              "logEveryNSteps": {
                "type": "number",
                "label": "Log every N steps",
                "name": "logEveryNSteps",
                "value": "50",
                "min": 1,
                "help": "How often training metrics are written to TensorBoard."
              }
            }
          },
          "advRow2": {
            "type": "rowContainer",
            "label": "",
            "elements": {
              "logDir": {
                "type": "picker",
                "label": "Log directory",
                "name": "logDir",
                "localLabel": "Location",
                "showFiles": "False",
                "files": "False",
                "defaultLocation": "./lightning_logs",
                "defaultPaths": {
                  "HOME": "$HOME",
                  "SCRATCH": "/scratch/user/$USER"
                },
                "useHPCDefaultPaths": "False",
                "help": "Directory where Lightning TensorBoard/CSV logs and checkpoints are written. Defaults to ./lightning_logs relative to the job staging directory."
              }
            }
          },
          "advRow3": {
            "type": "rowContainer",
            "label": "",
            "elements": {
              "checkpointEnable": {
                "type": "checkbox",
                "label": "Save best checkpoint",
                "name": "checkpointEnable",
                "value": "Yes",
                "checked": true,
                "help": "When enabled, saves the best-performing model checkpoint based on minimum validation loss. When disabled, defaults to saving only the final model state at the last epoch."
              },
              "exportOnnx": {
                "type": "checkbox",
                "label": "Export to ONNX",
                "name": "exportOnnx",
                "value": "",
                "condition": "!modelCategory.gnn",
                "help": "When enabled, exports the trained model to ONNX format (final_model.onnx) at the end of the training run."
              }
            }
          }
        }
      }
    }
  },
  "slurmCollapse": {
    "type": "collapsibleRowContainer",
    "title": "RESOURCES",
    "default_state": "expanded",
    "layout": {
      "preset": "card",
      "title": "RESOURCES",
      "dot": false
    },
    "elements": {
      "ContainerNodes": {
        "type": "rowContainer",
        "label": "Nodes & data loading",
        "elements": {
          "drona_nodes": {
            "$ref": "$DRONA_RUNTIME_DIR/forms/drona_slurm_resources.json#/drona_slurmCollapse/elements/drona_ContainerTasks/elements/drona_nodes",
            "label": "Number of nodes",
            "value": "1",
            "help": "Number of nodes to train on. Tasks are set automatically: one task per GPU on each node (one per node without GPUs), each with DataLoader workers + 1 CPUs."
          },
          "numWorkers": {
            "type": "number",
            "label": "Data workers",
            "name": "numWorkers",
            "value": "0",
            "help": "Background processes that load data for each training process. Each process gets workers + 1 CPUs. 0 loads data in the main process; 2-8 usually keeps a GPU busy.",
            "min": 0,
            "max": 32
          }
        }
      },
      "drona_ContainerGPU": {
        "type": "rowContainer",
        "label": "GPU",
        "condition": "drona_training.",
        "elements": {
          "drona_gpuDropdown": {
            "type": "dynamicSelect",
            "label": "Use Accelerator",
            "help": "Only select an accelerator if your job will utilize them. You might need to setup the environment for the accelerator you selected in the job script.",
            "name": "drona_gpu",
            "retriever": "retrieve_gpus",
            "hideWhenSingle": true,
            "autoSelect": "first"
          },
          "drona_numgpus": {
            "type": "number",
            "label": "#GPUs",
            "help": "Number of accelerators you want to use.",
            "name": "drona_numgpu",
            "value": "1",
            "condition": " !drona_gpu.none && !drona_gpu. "
          }
        }
      },
      "ptResourceSummaryRow": {
        "type": "rowContainer",
        "label": "",
        "elements": {
          "ptResourceSummary": {
            "type": "staticText",
            "name": "ptResourceSummary",
            "useLabel": false,
            "isDynamic": true,
            "allowHtml": true,
            "showRefreshButton": false,
            "retriever": "retrieve_pt_resource_summary.sh",
            "retrieverParams": {
              "NODES": "$drona_nodes",
              "WORKERS": "$numWorkers",
              "GPU": "$drona_gpu",
              "NUMGPU": "$drona_numgpu",
              "BATCH": "$batchSize"
            }
          }
        }
      },
      "slurmAdditional": {
        "type": "collapsibleRowContainer",
        "title": "ADDITIONAL",
        "default_state": "collapsed",
        "layout": {
          "preset": "card",
          "title": "ADDITIONAL",
          "compact": true,
          "summary": "walltime $drona_walltime · memory $drona_memory · account $drona_account · extra $drona_extra_slurm"
        },
        "elements": {
          "drona_ContainerAdditional": {
            "$ref": "$DRONA_RUNTIME_DIR/forms/drona_slurm_resources.json#/drona_slurmCollapse/elements/drona_ContainerAdditional"
          }
        }
      }
    }
  },
  "monitoringCollapse": {
    "type": "collapsibleRowContainer",
    "title": "MONITORING",
    "default_state": "collapsed",
    "layout": {
      "preset": "card",
      "title": "MONITORING",
      "summary": "CPU $drona_cpu_monitor · GPU $drona_gpu_monitor · TensorBoard $tbEnable"
    },
    "elements": {
      "drona_monitoringRow": {
        "type": "rowContainer",
        "label": "",
        "elements": {
          "drona_cpuMonitorEnable": {
            "$ref": "$DRONA_RUNTIME_DIR/forms/drona_monitoring.json#/drona_monitoringCollapse/elements/drona_monitoringRow/elements/drona_cpuMonitorEnable"
          },
          "drona_gpuMonitorEnable": {
            "$ref": "$DRONA_RUNTIME_DIR/forms/drona_monitoring.json#/drona_monitoringCollapse/elements/drona_monitoringRow/elements/drona_gpuMonitorEnable"
          },
          "tbEnable": {
            "type": "checkbox",
            "name": "tbEnable",
            "label": "TensorBoard",
            "style": "button",
            "value": "yes",
            "checked": true,
            "help": "Start a TensorBoard server inside the job so you can follow the training curves live from Manage. Logs for TensorBoard are always written; without this you can still start TensorBoard later from Manage (as a separate small job)."
          }
        }
      }
    }
  }
}
