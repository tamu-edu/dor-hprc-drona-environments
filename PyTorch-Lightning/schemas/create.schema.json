{
  "runDestinationFinal": {
    "$ref": "$DRONA_RUNTIME_DIR/forms/drona_job_destination.json#/drona_runDestinationFinal",
    "help": "Optional. Leave blank to use defaults. If empty, the engine will assign a job ID and staging path automatically. Spaces in the job name are converted to underscores."
  },
  "taskCard": {
    "type": "container",
    "layout": {
      "preset": "card",
      "title": "TASK",
      "dot": false
    },
    "elements": {
      "modelCategory": {
        "type": "radioGroup",
        "name": "modelCategory",
        "label": "Task type",
        "help": "Picks the train.py template. Custom: bare-bones template, any data. Vision: classification/segmentation/ViT on images (.png, .jpg, .jpeg, .bmp, .webp) or .pt tensors. Time series: LSTM/GRU/1D CNN/Transformer on .csv. Text: .csv, .tsv, .txt. Tabular: .csv. Audio: .wav, .mp3, .flac, .ogg. Generative: VAE/GAN/diffusion on images. Graph: PyTorch Geometric .pt.",
        "options": [
          {
            "label": "Vision",
            "value": "computer_vision"
          },
          {
            "label": "Text (NLP)",
            "value": "nlp"
          },
          {
            "label": "Time series",
            "value": "sequential"
          },
          {
            "label": "Tabular",
            "value": "tabular"
          },
          {
            "label": "Audio",
            "value": "audio"
          },
          {
            "label": "Graph (GNN)",
            "value": "gnn"
          },
          {
            "label": "Generative",
            "value": "generative"
          },
          {
            "label": "Custom",
            "value": "custom"
          }
        ],
        "value": "computer_vision",
        "style": "button"
      }
    }
  },
