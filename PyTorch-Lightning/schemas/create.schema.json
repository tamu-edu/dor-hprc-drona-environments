  "modelCard": {
    "type": "container",
    "condition": "!modelCategory.custom",
    "layout": {
      "preset": "card",
      "title": "MODEL",
      "dot": false
    },
    "elements": {
      "cvModelRow": {
        "type": "rowContainer",
        "label": "Architecture",
        "condition": "modelCategory.computer_vision",
        "elements": {
          "cvModelArch": {
            "type": "select",
            "label": "",
            "name": "cvModelArch",
            "value": "cnn",
            "options": [
              {
                "value": "cnn",
                "label": "CNN Classification"
              },
              {
                "value": "mlp",
                "label": "MLP Classification"
              },
              {
                "value": "vit",
                "label": "Vision Transformer (ViT)"
              },
              {
                "value": "unet",
                "label": "U-Net Semantic Segmentation"
              }
            ],
            "condition": "datasetType.custom",
            "help": "Architecture for your own image data."
          },
          "cvExampleNote": {
            "type": "staticText",
            "name": "cvExampleNote",
            "label": "",
            "value": "<div style=\"background:#f6f7f9;border-left:3px solid #500000;border-radius:4px;padding:4px 10px;font-size:0.875em;line-height:1.4;color:#334155\"><span style=\"font-size:0.8em;font-weight:700;letter-spacing:0.04em;color:#500000\">EXAMPLE MODEL</span> <strong>CNN classifier</strong><span style=\"color:#64748b\"> · always used with the ImageNet example (1000 classes, 224 px).</span></div>",
            "condition": "datasetType.builtin",
            "allowHtml": true,
            "useLabel": false
          }
        }
      },
      "cvSettingsRow": {
        "type": "rowContainer",
        "label": "Images",
        "condition": "modelCategory.computer_vision && datasetType.custom",
        "elements": {
          "cvImageSize": {
            "type": "number",
            "label": "Image size (px)",
            "name": "cvImageSize",
            "value": "0",
            "help": "Target image dimension (H=W in pixels) for resizing during training. Default is 0 for automatic detection of image size.",
            "min": 0,
            "max": 4096
          },
          "cvChannels": {
            "type": "select",
            "label": "Channels",
            "name": "cvChannels",
            "value": "3",
            "options": [
              {
                "value": "3",
                "label": "RGB (3 channels)"
              },
              {
                "value": "1",
                "label": "Grayscale (1 channel)"
              }
            ],
            "help": "Number of input channels. Use Grayscale (1 channel) for MNIST or grayscale medical scans, RGB (3 channels) for color photos."
          }
        }
      },
      "seqModelRow": {
        "type": "rowContainer",
        "label": "Architecture",
        "condition": "modelCategory.sequential",
        "elements": {
          "seqModelType": {
            "type": "select",
            "label": "",
            "name": "seqModelType",
            "value": "lstm",
            "options": [
              {
                "value": "lstm",
                "label": "LSTM (Long Short-Term Memory)"
              },
              {
                "value": "gru",
                "label": "GRU (Gated Recurrent Unit)"
              },
              {
                "value": "cnn1d",
                "label": "1D CNN (Temporal ConvNet)"
              },
              {
                "value": "transformer",
                "label": "Transformer Encoder"
              }
            ],
            "help": "Select sequence modeling architecture (LSTM, GRU, 1D CNN, or Transformer) to train on sequence .csv data."
          },
          "seqTaskType": {
            "type": "radioGroup",
            "name": "seqTaskType",
            "label": "Task type",
            "options": [
              {
                "label": "Regression",
                "value": "regression"
              },
              {
                "label": "Classification",
                "value": "classification"
              }
            ],
            "value": "regression"
          }
        }
      },
      "seqSettingsRow": {
        "type": "rowContainer",
        "label": "Sequence",
        "condition": "modelCategory.sequential",
        "elements": {
          "seqLen": {
            "type": "number",
            "label": "Lookback window",
            "name": "seqLen",
            "value": "50",
            "min": 1,
            "help": "Number of past time steps the model sees."
