            "localLabel": "cluster",
            "showFiles": "True",
            "files": "True",
            "help": "Select a file or directory containing your custom training dataset (e.g. .pt, .csv, .npy, .h5, or dataset folder). This path will be loaded inside the generated train.py script."
          }
        }
      },
