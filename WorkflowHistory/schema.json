{
  "workflowHistory": {
    "type": "container",
    "layout": {
      "preset": "card",
      "title": "Workflow History",
      "dot": false,
      "accent": true
    },
    "elements": {
      "historyTable": {
        "type": "dynamicTable",
        "label": "Workflows",
        "labelOnTop": true,
        "name": "drona_create_manage_allworkflows",
        "retriever": "builtin:db_options",
        "retrieverParams": {
          "environment": "*",
          "columns": {
            "Environment": "{environment}",
            "Name": "{name}",
            "Workflow ID": "{drona_id}",
            "Date": "{start_time:10}",
            "Location": "{location}"
          }
        },
        "columns": [
          {
            "width": "150px"
          },
          {
            "width": "22%"
          },
          {
            "width": "110px"
          },
          {
            "width": "120px"
          },
          {}
        ],
        "maxHeight": "350px",
        "emptyMessage": "No workflows have been recorded yet",
        "collapseOnSelect": true,
        "pagination": true
      }
    }
  },
  "hidden_jobs_check": {
    "$ref": "$DRONA_RUNTIME_DIR/form_components/drona_info_jobs.json#/drona_hidden_jobs_check"
  },
  "hidden_status_check": {
    "$ref": "$DRONA_RUNTIME_DIR/form_components/drona_info_status.json#/drona_hidden_selected_job_status_check"
  },
  "hidden_jobdir_path": {
    "$ref": "$DRONA_RUNTIME_DIR/form_components/drona_info_jobdir.json#/drona_hidden_jobdir_path"
  },
  "workingDirectory": {
    "$ref": "$DRONA_RUNTIME_DIR/form_components/drona_info_jobdir_view.json#/drona_workingDirectory"
  },
  "slurmInfo": {
    "type": "container",
    "condition": "!drona_create_manage_allworkflows. && !drona_info_jobs.",
    "layout": {
      "preset": "card",
      "title": "Slurm Panel"
    },
    "elements": {
      "drona_slurm_summary": {
        "type": "staticText",
        "useLabel": false,
        "name": "drona_slurm_jobs_panel",
        "isDynamic": true,
        "allowHtml": true,
        "showRefreshButton": true,
        "retrieverParams": {
          "JOBS": "$drona_info_jobs"
        },
        "retriever": "drona_slurm_jobs.sh",
        "layout": {
          "preset": "boxed",
          "title": "Slurm Jobs"
        }
      }
    }
  },
  "workflowActions": {
    "type": "container",
    "condition": "!drona_create_manage_allworkflows.",
    "layout": {
      "preset": "card",
      "title": "WORKFLOW ACTIONS",
      "dot": false
    },
    "elements": {
      "workflowActionsRow": {
        "type": "workflowRerunRecreate",
        "name": "drona_rerun_recreate",
        "compact": true,
        "showDelete": true,
        "showDisclaimer": true
      }
    }
  }
}
