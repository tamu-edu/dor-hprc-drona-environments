{
  "workflowCollapse": {
    "type": "collapsibleRowContainer",
    "title": "WORKFLOW OPTIONS",
    "default_state": "expanded",
    "layout": {
      "preset": "card",
      "title": "WORKFLOW OPTIONS",
      "dot": false
    },
    "elements": {
      "runDestinationFinal": {
        "$ref": "$DRONA_RUNTIME_DIR/forms/drona_job_destination.json#/drona_runDestinationFinal"
      },
      "InputPicker": {
        "type": "picker",
        "label": "LAMMPS input file",
        "name": "filepicker",
        "localLabel": "select",
        "showFiles": "True",
        "defaultPaths": {
          "Examples": "/sw/hprc/sw/lammps-validator/example-inputs"
        },
        "help": "Select the LAMMPS input file you want to evaluate. It must already be on the cluster.",
        "files": "True"
      },
      "thermoTip": {
        "type": "staticText",
        "name": "thermo_tip",
        "useLabel": false,
        "isDynamic": true,
        "retriever": "retrieve_create_tips.sh",
        "allowHtml": true
      }
    }
  },
  "strategyCollapse": {
    "type": "collapsibleRowContainer",
    "title": "ACCELERATION STRATEGY",
    "default_state": "expanded",
    "layout": {
      "preset": "card",
      "title": "ACCELERATION STRATEGY",
      "dot": false
    },
    "elements": {
      "GPU_fields": {
        "type": "collapsibleColContainer",
        "title": "Accelerator availability",
        "isDynamic": true,
        "condition": "!filepicker.",
        "elements": {
          "gpuavail_table": {
            "type": "staticText",
            "name": "gpuavail",
            "useLabel": false,
            "isDynamic": true,
            "retriever": "gputable.sh",
            "retrieverParams": {
              "FILTER_ACCEL": "$filter_accel"
            },
            "showRefreshButton": true,
            "allowHtml": true
          }
        }
      },
      "Strategy_filters": {
        "type": "rowContainer",
        "isDynamic": true,
        "condition": "!filepicker.",
        "elements": {
          "filterAcceleratorGroup": {
            "type": "dynamicCheckboxGroup",
            "name": "filter_accel",
            "label": "Filter by hardware",
            "layout": "inline",
            "style": "button",
            "retriever": "retrieve_accelerators",
            "help": "Only list strategies for the checked hardware. None checked lists all."
          },
          "filterPackageGroup": {
            "type": "checkboxGroup",
            "name": "filter_pkg",
            "label": "Filter by package",
            "layout": "inline",
            "style": "button",
            "options": [
              {
                "value": "kokkos",
                "label": "Kokkos"
              },
              {
                "value": "gpu",
                "label": "GPU package"
              },
              {
                "value": "openmp",
                "label": "OpenMP"
              },
              {
                "value": "intel",
                "label": "Intel package"
              }
            ],
            "help": "Only list strategies that use the checked LAMMPS acceleration package. None checked lists all."
          }
        }
      },
      "Strategy_table": {
        "type": "dynamicTable",
        "name": "reportjson",
        "label": "Acceleration strategy",
        "labelOnTop": true,
        "isDynamic": true,
        "condition": "!filepicker.",
        "retriever": "retrieve_strategy_table.sh",
        "retrieverParams": {
          "FILE": "$filepicker",
          "FILTER_ACCEL": "$filter_accel",
          "FILTER_PKG": "$filter_pkg"
        },
        "columns": [
          {
            "width": "22%"
          },
          {
            "width": "18%"
          },
          {}
        ],
        "searchPlaceholder": "Search hardware, package or build",
        "maxHeight": "300px",
        "collapseOnSelect": true,
        "collapseRestoredValue": true,
        "showRefreshButton": true,
        "emptyMessage": "No compatible LAMMPS build found for this input with the checked filters.",
        "help": "Click a row to choose how LAMMPS runs your input: on which hardware, with which acceleration package and LAMMPS build."
      },
      "Module_summary": {
        "type": "staticText",
        "name": "reporttext",
        "label": "",
        "isDynamic": true,
        "condition": "!reportjson.",
        "retriever": "extract_summary.sh",
        "retrieverParams": {
          "REPORT_JSON": "$reportjson"
        },
        "showRefreshButton": false,
        "allowHtml": true
      },
      "hidden_accelerator_option": {
        "type": "hidden",
        "name": "gpu_type",
        "isDynamic": true,
        "condition": "!reportjson.",
        "retriever": "extract_gpu_type.sh",
        "retrieverParams": {
          "REPORT_JSON": "$reportjson"
        }
      },
      "hidden_accel_vendor": {
        "type": "hidden",
        "name": "accel_vendor",
        "isDynamic": true,
        "condition": "!reportjson.",
        "retriever": "extract_accel_vendor.sh",
        "retrieverParams": {
          "REPORT_JSON": "$reportjson"
        }
      },
      "hidden_gpu_count_kind": {
        "type": "hidden",
        "name": "gpu_count_kind",
        "isDynamic": true,
        "condition": "!reportjson.",
        "retriever": "extract_gpu_count_kind.sh",
        "retrieverParams": {
          "REPORT_JSON": "$reportjson"
        }
      },
      "GPU_select_list": {
        "type": "dynamicSelect",
        "name": "gpu_count",
        "condition": "!reportjson. && gpu_count_kind.list",
        "label": "Requested accelerator count",
        "retriever": "retrieve_gpu_counts.sh",
        "retrieverParams": {
          "REPORT_JSON": "$reportjson"
        },
        "autoSelect": "first",
        "help": "Choose how many accelerators of this type your job uses; this type only allows these counts."
      },
      "GPU_select": {
        "type": "number",
        "name": "gpu_count",
        "condition": "!reportjson. && gpu_count_kind.number",
        "label": "Requested accelerator count",
        "value": "1",
        "help": "Choose a number of accelerators for your job."
      },
      "CPU_select": {
        "type": "number",
        "name": "cpu_count",
        "condition": "!reportjson. && gpu_type.cpu",
        "label": "Requested CPU count",
        "value": "1",
        "help": "Choose a number of CPUs for your job."
      }
    }
  },
  "resourcesCollapse": {
    "type": "collapsibleRowContainer",
    "title": "RESOURCES",
    "default_state": "expanded",
    "layout": {
      "preset": "card",
      "title": "RESOURCES",
      "dot": false
    },
    "elements": {
      "ContainerAdditional": {
        "type": "rowContainer",
        "elements": {
          "memory": {
            "$ref": "$DRONA_RUNTIME_DIR/forms/drona_slurm_resources.json#/drona_slurmCollapse/elements/drona_ContainerAdditional/elements/drona_memory",
            "help": "OPTIONAL: Total memory for the job. If you leave this empty, 40G is used."
          },
          "Walltime": {
            "$ref": "$DRONA_RUNTIME_DIR/forms/drona_slurm_resources.json#/drona_slurmCollapse/elements/drona_ContainerAdditional/elements/drona_Walltime",
            "help": "OPTIONAL: Time the job needs. If you leave this empty, 2 hours is used."
          }
        }
      },
      "ContainerAccount": {
        "type": "rowContainer",
        "elements": {
          "account": {
            "$ref": "$DRONA_RUNTIME_DIR/forms/drona_slurm_resources.json#/drona_slurmCollapse/elements/drona_ContainerAdditional/elements/drona_account"
          },
          "extraText": {
            "$ref": "$DRONA_RUNTIME_DIR/forms/drona_slurm_resources.json#/drona_slurmCollapse/elements/drona_ContainerAdditional/elements/drona_extraText"
          }
        }
      }
    }
  },
  "monitoring": {
    "type": "collapsibleRowContainer",
    "title": "MONITORING",
    "default_state": "collapsed",
    "layout": {
      "preset": "card",
      "title": "MONITORING",
      "dot": false
    },
    "elements": {
      "monitoringRow": {
        "type": "rowContainer",
        "elements": {
          "cpuMonitorEnable": {
            "$ref": "$DRONA_RUNTIME_DIR/forms/drona_monitoring.json#/drona_monitoringCollapse/elements/drona_monitoringRow/elements/drona_cpuMonitorEnable"
          },
          "gpuMonitorEnable": {
            "$ref": "$DRONA_RUNTIME_DIR/forms/drona_monitoring.json#/drona_monitoringCollapse/elements/drona_monitoringRow/elements/drona_gpuMonitorEnable",
            "help": "Collect NVIDIA GPU utilization/memory usage in the background while the job runs, viewable as a live chart under Manage. Only for NVIDIA GPUs.",
            "condition": "!reportjson. && accel_vendor.nvidia"
          }
        }
      }
    }
  }
}
