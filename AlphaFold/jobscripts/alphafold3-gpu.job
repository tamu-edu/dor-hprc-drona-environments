#!/bin/bash

#SBATCH --job-name=af3-[AF3NAME]-gpu
#SBATCH --time=[TIME]
#SBATCH --nodes=[NODES]
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=[CPUS]
#SBATCH --mem=[MEM]
[PARTITION]
#SBATCH --output=out.%j
#SBATCH --error=error.%j
#DRONA label: Prediction (GPU)
[EXTRA]
[email]

module purge
module load AlphaFold3/3.0.1

# Shared resources (same as CPU job)
AF3_CODE_DIR=/scratch/data/bio/alphafold3/code/alphafold3-3.0.1
AF3_DATABASES_DIR=/scratch/data/bio/alphafold3/db/2025.03.13
AF3_IMAGE=/sw/hprc/sw/bio/containers/alphafold/alphafold_3.0.1_unlhcc.sif
AF3_MODEL_PARAMETERS_DIR=[ALPHAFOLD3MODEL]

# Find the output directory created by the CPU job
AF3_OUTPUT_DIR=$(cat "$SLURM_SUBMIT_DIR/af3_output_dir.txt" 2>/dev/null)
if [ -z "$AF3_OUTPUT_DIR" ] || [ ! -d "$AF3_OUTPUT_DIR" ]; then
    echo "ERROR: Cannot find AF3 output directory. Expected af3_output_dir.txt in $SLURM_SUBMIT_DIR"
    exit 1
fi

# Derive protein name from the subdirectory the CPU job created
lc_protein_name=$(ls -1 "$AF3_OUTPUT_DIR" | head -1)
AF3_INPUT_DIR=$AF3_OUTPUT_DIR/$lc_protein_name
AF3_INPUT_FILE=${lc_protein_name}_data.json


[CPU_MONITOR_START]
[GPU_MONITOR_START]

# Attention settings for the GPU this job got (docs/performance.md): CUDA capability 7.x (T4, V100,
# RTX 6000/8000) needs XLA attention plus an XLA workaround flag; Ampere and newer use Triton flash
# attention (faster) and the upstream compile-time XLA flag.
gpu_cc=$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader -i 0 2>/dev/null | tr -d ' ')
if [ -n "$gpu_cc" ] && [ "${gpu_cc%%.*}" -lt 8 ] 2>/dev/null; then
    AF3_ATTENTION=xla
    AF3_XLA_FLAGS=--xla_disable_hlo_passes=custom-kernel-fusion-rewriter
else
    AF3_ATTENTION=triton
    AF3_XLA_FLAGS=--xla_gpu_enable_triton_gemm=false
fi
echo "GPU: $(nvidia-smi --query-gpu=name --format=csv,noheader -i 0 2>/dev/null) (compute capability ${gpu_cc:-unknown}) -> $AF3_ATTENTION attention"

singularity exec \
  --nv \
  --env XLA_PYTHON_CLIENT_PREALLOCATE=false \
  --env TF_FORCE_UNIFIED_MEMORY=true \
  --env XLA_CLIENT_MEM_FRACTION=3.2 \
  --env XLA_FLAGS=$AF3_XLA_FLAGS \
  --bind $AF3_CODE_DIR \
  --bind $AF3_INPUT_DIR:/root/af_input \
  --bind $AF3_OUTPUT_DIR:/root/af_output \
  --bind $AF3_MODEL_PARAMETERS_DIR:/root/models \
  --bind $AF3_DATABASES_DIR:/root/public_databases \
  $AF3_IMAGE \
  python $AF3_CODE_DIR/run_alphafold.py \
  --norun_data_pipeline  \
  --input_dir=/root/af_input \
  --json_path=/root/af_input/$AF3_INPUT_FILE \
  --output_dir=/root/af_output \
  --model_dir=/root/models \
  --db_dir=/root/public_databases \
  --max_template_date="[maxtemplate]" \
  --num_recycles=[RECYCLES][SEEDS] --flash_attention_implementation=$AF3_ATTENTION
af_status=$?

[GPU_MONITOR_STOP]
[CPU_MONITOR_STOP]

[AUTOBUNDLE]

exit $af_status

