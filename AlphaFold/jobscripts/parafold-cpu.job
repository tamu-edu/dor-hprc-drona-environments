#!/bin/bash
#SBATCH --job-name=alphafold-[JOBNAME]
#SBATCH --time=[CPUTIME]
#SBATCH --ntasks=1 --cpus-per-task=[AF2CPUS] --mem=[AF2MEM]
#SBATCH --output=out.%j --error=error.%j
#DRONA label: MSA (CPU)
[EXTRA]
[email]

module purge
[ALPHAFOLDMODULES]

protein_fasta=[proteinfasta]

[CPU_MONITOR_START]

# First, run CPU-only steps to get multiple sequence alignments:
run_alphafold.sh -d [datadir] -o parafold_output_dir  -i $protein_fasta -p [modelpreset] -t [maxtemplate] -f

[CPU_MONITOR_STOP]

